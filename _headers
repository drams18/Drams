# Cloudflare Pages — cache. Les fichiers ne sont pas versionnés (pas de
# hash dans les noms) : cache long uniquement pour les médias lourds,
# court pour HTML / CSS / JS afin qu'une mise en ligne soit vue tout de suite.
/assets/audio/*
  Cache-Control: public, max-age=2592000
/sounds/*
  Cache-Control: public, max-age=2592000
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=604800
/css/*
  Cache-Control: public, max-age=3600
/js/*
  Cache-Control: public, max-age=3600
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
